{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Graywood-5e-VTT",
  "version": "1.0.0",
  "identifier": "com.graywood.dndvtt",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "5e SRD Virtual Tabletop - Graywood",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "devtools": true,
        "hardwareAcceleration": true
      }
    ],
    "security": {
      "csp": "default-src 'self' blob: data: 'unsafe-inline' 'unsafe-eval' ws: http: https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "identifier": "com.graywood.dndvtt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
